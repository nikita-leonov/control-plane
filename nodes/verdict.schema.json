{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-plane.local/verdict.schema.json",
  "title": "Node result envelope",
  "description": "What a node returns. A closed enum plus a small typed payload \u2014 never prose. An edge that has to read a paragraph to decide where to go is a regex pretending to be a state machine.",
  "type": "object",
  "required": [
    "node",
    "token",
    "verdict",
    "attempt"
  ],
  "additionalProperties": false,
  "properties": {
    "node": {
      "type": "string",
      "pattern": "^[a-z][a-z-]{1,23}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z]+-[a-z0-9.-]+$",
      "description": "The beads issue travelling the graph."
    },
    "verdict": {
      "type": "string",
      "pattern": "^[a-z][a-z-]{1,31}$",
      "description": "Checked against this node's closed enum in node-types.json."
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "payload": {
      "type": "object"
    },
    "question": {
      "$ref": "#/$defs/question"
    },
    "evidence": {
      "type": "string",
      "maxLength": 512,
      "description": "Path to an evidence file. A path, not its contents."
    }
  },
  "$defs": {
    "pointer": {
      "description": "A reference plus one line on why. Deliberately not free text \u2014 a pointer cannot become an argument aimed at the next node.",
      "type": "object",
      "required": [
        "ref",
        "why"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "maxLength": 256
        },
        "why": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "question": {
      "description": "Emitted when a verdict parks the token on a human node. The options ARE that node's outgoing edges \u2014 a human node is a node like any other, and this is just its edge list rendered for a person.",
      "type": "object",
      "required": [
        "asks",
        "options"
      ],
      "additionalProperties": false,
      "properties": {
        "asks": {
          "type": "string",
          "minLength": 8,
          "maxLength": 280,
          "description": "The decision, as one question. Capped on purpose: a decision that needs an essay is not ready to be asked."
        },
        "context": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/pointer"
          }
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "value",
              "means",
              "edge"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              },
              "means": {
                "type": "string",
                "minLength": 4,
                "maxLength": 200
              },
              "edge": {
                "type": "string",
                "pattern": "^(@[a-z]+|[a-z][a-z0-9-]{0,47})$",
                "description": "The edge crossed if this option is chosen. A terminal (@park, @done) is allowed: 'leave it as it is' is a real answer to a decision, and has to be expressible as one."
              }
            }
          }
        }
      }
    },
    "paths": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 256,
        "pattern": "^[^/].*$"
      },
      "description": "Repo-relative paths. Leading slash rejected: a node reports on this repo."
    },
    "builderDone": {
      "type": "object",
      "required": [
        "files",
        "commits"
      ],
      "additionalProperties": false,
      "properties": {
        "files": {
          "$ref": "#/$defs/paths"
        },
        "commits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "description": "The chunking plan. Judgment \u2014 which is why it comes from a node. Executing it is not, which is why that happens on an edge.",
          "items": {
            "type": "object",
            "required": [
              "message",
              "files"
            ],
            "additionalProperties": false,
            "properties": {
              "message": {
                "type": "string",
                "minLength": 8,
                "maxLength": 4096
              },
              "files": {
                "$ref": "#/$defs/paths"
              }
            }
          }
        }
      }
    },
    "reviewerApprove": {
      "type": "object",
      "required": [
        "criteria_met"
      ],
      "additionalProperties": false,
      "properties": {
        "criteria_met": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "description": "Which acceptance criteria were checked. An approval that cannot name them is not an approval."
        }
      }
    },
    "reviewerReject": {
      "type": "object",
      "required": [
        "findings"
      ],
      "additionalProperties": false,
      "properties": {
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "file",
              "summary"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "maxLength": 256
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "criterion": {
                "type": "string",
                "maxLength": 200
              },
              "summary": {
                "type": "string",
                "minLength": 8,
                "maxLength": 400
              }
            }
          }
        }
      }
    },
    "findingsOnly": {
      "type": "object",
      "required": [
        "findings"
      ],
      "additionalProperties": false,
      "properties": {
        "findings": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/pointer"
          }
        }
      }
    },
    "filesOnly": {
      "type": "object",
      "required": [
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "files": {
          "$ref": "#/$defs/paths"
        }
      }
    },
    "issuesOnly": {
      "type": "object",
      "required": [
        "issues"
      ],
      "additionalProperties": false,
      "properties": {
        "issues": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "pattern": "^[a-z]+-[a-z0-9.-]+$"
          },
          "description": "Issue ids. The Groomer files work; it does not describe it here."
        }
      }
    },
    "empty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  }
}

#!/usr/bin/env bash
# verify — the gate for control-plane. Exit 0 means this tree is mergeable.
#
#   ./verify              every check
#   ./verify --fast       only the sub-30s checks; agents run this in the loop
#   ./verify --evidence   also write verify-report.json for the control plane
#
# The three flags are the same in every factory, so one control plane can read
# any repo. Exit 0 = mergeable, 1 = a check failed, 2 = verify itself is broken.
#
# Generated from a shared template. Edit the CHECKS block; leave the machinery
# alone so `cp doctor` can tell when a repo has drifted.

set -uo pipefail
cd "$(dirname "$(readlink -f "$0")")"

REPO_NAME="control-plane"
MODE=full
EVIDENCE=0

for arg in "$@"; do
  case "$arg" in
    --fast)     MODE=fast ;;
    --evidence) EVIDENCE=1 ;;
    -h|--help)  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf 'verify: unknown option %s (try --help)\n' "$arg" >&2; exit 2 ;;
  esac
done

command -v jq >/dev/null 2>&1 || { echo "verify: jq is required" >&2; exit 2; }

if [ -t 1 ]; then
  B=$'\033[1m'; D=$'\033[2m'; R=$'\033[31m'; G=$'\033[32m'; N=$'\033[0m'
else
  B=; D=; R=; G=; N=
fi

CHECKS='[]'
FAILED=0
STARTED=$(date +%s)

# check <name> <fast|full> <command...>
#
# Captures output and shows it only on failure — a green run stays one line per
# check, so a red one is impossible to miss.
check() {
  local name=$1 tier=$2
  shift 2

  if [ "$MODE" = fast ] && [ "$tier" != fast ]; then
    printf '  %s-  %-24s skipped (--fast)%s\n' "$D" "$name" "$N"
    CHECKS=$(jq -c --arg n "$name" '. + [{name:$n,status:"skipped",ms:0,output:""}]' <<<"$CHECKS")
    return 0
  fi

  local t0 t1 ms out rc
  t0=$(date +%s%3N)
  out=$("$@" 2>&1)
  rc=$?
  t1=$(date +%s%3N)
  ms=$((t1 - t0))

  if [ "$rc" -eq 0 ]; then
    printf '  %s+%s  %-24s %s%s.%ss%s\n' "$G" "$N" "$name" "$D" "$((ms / 1000))" "$(( (ms % 1000) / 100 ))" "$N"
    CHECKS=$(jq -c --arg n "$name" --argjson m "$ms" \
      '. + [{name:$n,status:"pass",ms:$m,output:""}]' <<<"$CHECKS")
  else
    FAILED=$((FAILED + 1))
    printf '  %s!%s  %-24s %sexit %d%s\n' "$R" "$N" "$name" "$R" "$rc" "$N"
    printf '%s\n' "$out" | tail -30 | sed 's/^/       /'
    CHECKS=$(jq -c --arg n "$name" --argjson m "$ms" --arg o "$(printf '%s' "$out" | tail -30)" \
      '. + [{name:$n,status:"fail",ms:$m,output:$o}]' <<<"$CHECKS")
  fi
  return 0
}

printf '%s%s%s  %s\n' "$B" "$REPO_NAME" "$N" "$MODE"

# ---------------------------------------------------------------- CHECKS ----
# The panel gates itself. It holds the verdict contract that every node's output
# is validated against, so a break here is a break in all three factories at once.

check "tests"       fast python3 -m unittest discover -s tests -q

# A typo in a schema file is a silent contract change — every .json here is part
# of a contract, so a parse failure must be a gate failure and not a surprise at
# the first node invocation.
check "json"        fast python3 -c "
import json,pathlib,sys
bad=[]
for p in sorted(pathlib.Path('.').glob('**/*.json')):
    if any(x in p.parts for x in ('.git','.beads','state','node_modules')): continue
    try: json.loads(p.read_text())
    except Exception as e: bad.append(f'{p}: {e}')
print('\n'.join(bad) or f'{len(list(pathlib.Path(\".\").glob(\"nodes/*.json\")))} contract files parse', file=sys.stderr if bad else sys.stdout)
sys.exit(1 if bad else 0)"

# A route to a node that does not exist is a token that deadlocks halfway through
# a factory, by which point the useful information is gone. Cheap to check here.
check "graph"       fast python3 tools/check-graph.py

# The graph rests on edges being deterministic scripts whose exit code selects
# the branch. An edge that shells out to a model, or returns a code nothing
# routes, breaks that while still looking like a working script.
check "edges"       fast python3 tools/check-edges.py

# GRAPH.md promises that nothing is described without an issue behind it. That
# rule was enforced by hand until it became this.
check "issue refs"  full python3 tools/check-issue-refs.py

# This backlog is about how work moves, not about what a product does. The rule
# was written in README.md and then quietly eroded, because a factory with no
# tracker of its own leaves its work nowhere else to go.
check "backlog scope" full python3 tools/check-backlog-scope.py
# ------------------------------------------------------------ END CHECKS ----

ELAPSED=$(( $(date +%s) - STARTED ))
echo
if [ "$FAILED" -eq 0 ]; then
  printf '%sgreen%s  %s, %ss\n' "$G$B" "$N" "$MODE" "$ELAPSED"
else
  printf '%sred%s  %d check(s) failed, %ss\n' "$R$B" "$N" "$FAILED" "$ELAPSED"
fi

if [ "$EVIDENCE" -eq 1 ]; then
  jq -n \
    --arg repo    "$REPO_NAME" \
    --arg commit  "$(git rev-parse --short HEAD 2>/dev/null || echo unknown)" \
    --arg branch  "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)" \
    --arg mode    "$MODE" \
    --arg ran_at  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson dirty    "$(git status --porcelain 2>/dev/null | wc -l)" \
    --argjson seconds  "$ELAPSED" \
    --argjson failed   "$FAILED" \
    --argjson checks   "$CHECKS" \
    '{repo:$repo, commit:$commit, branch:$branch, mode:$mode, ran_at:$ran_at,
      dirty_files:$dirty, seconds:$seconds, ok:($failed == 0),
      failed:$failed, checks:$checks}' > verify-report.json
  printf '%sevidence -> verify-report.json%s\n' "$D" "$N"
fi

exit $(( FAILED > 0 ? 1 : 0 ))

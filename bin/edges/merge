#!/usr/bin/env bash
# merge — put the token's branch on the factory's main line.
#
# Reached only after ./verify has passed on the full tier and a Reviewer has
# approved, and — for finance-c-and-c — only after a person has said yes, which
# is a graph fact rather than a check in here.
. "$(dirname "$(readlink -f "$0")")/_lib.sh"
edge_no_dry_run
edge_needs CP_TOKEN CP_FACTORY

# The runner already decided where this edge runs (cwd: factory in graph.json).
# Reconstructing the path here would be a second opinion about it, and the two
# would disagree the first time a factory moved.
REPO=$(pwd)
git rev-parse --git-dir >/dev/null 2>&1 || edge_broken "$REPO is not a git repository"

BRANCH="cp/$CP_TOKEN"
git rev-parse --verify "$BRANCH" >/dev/null 2>&1 \
  || edge_broken "no branch $BRANCH — the commit edge never ran, or ran elsewhere"

# Merging on top of unrelated local edits would produce a commit nobody planned
# and nobody reviewed. That is the work not being ready, not the edge being broken.
[ -z "$(git status --porcelain)" ] \
  || edge_failed "$CP_FACTORY has uncommitted changes; refusing to merge over them"

TARGET=$(git symbolic-ref --short HEAD 2>/dev/null) \
  || edge_broken "detached HEAD in $CP_FACTORY — nothing to merge onto"
[ "$TARGET" != "$BRANCH" ] || edge_broken "$CP_FACTORY is already on $BRANCH"

BEFORE=$(git rev-parse HEAD)
if ! git -c "user.name=control-plane" -c "user.email=cp@localhost" \
       merge --no-ff --no-verify -m "Merge $CP_TOKEN" "$BRANCH" >/dev/null 2>&1; then
  git merge --abort >/dev/null 2>&1        # leave the repo where we found it
  edge_failed "merge of $BRANCH into $TARGET conflicts"
fi

AFTER=$(git rev-parse HEAD)
[ "$BEFORE" != "$AFTER" ] || edge_failed "merge produced no commit"
edge_ok "merge: $BRANCH -> $TARGET at ${AFTER:0:12}"

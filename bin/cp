#!/usr/bin/env python3
"""cp — the seat. One screen over every factory.

Read-only, deliberately. Anything that advances work is the runner's job; this
exists so that supervising four repos is reading one board rather than opening
four terminals. It tells the truth about what is not built yet rather than
rendering an empty section as if it were a quiet one.

  cp status              the board
  cp status --refresh    re-run every gate first (slower, current)
  cp work <factory>      what is ready, in progress and waiting there
  cp decisions           only the things waiting on Nikita
  cp serve [--port N]    the same thing in a browser, plus the graph

Exit 0 always for status; this reports, it does not gate. `bin/verify-all` is
the thing with an opinion.
"""

import json
import os
import pathlib
import subprocess
import sys
import time

HERE = pathlib.Path(__file__).resolve().parent
ROOT = HERE.parent
STATE_DIR = ROOT / "state"
SCENARIO = __import__("re").compile(r"^[a-z][a-z0-9-]{0,31}$")
PROJECTS = pathlib.Path("/mnt/projects")
FACTORIES = ["control-plane", "faceoff-finder", "ai-ih-coach", "finance-c-and-c"]

TTY = sys.stdout.isatty()
def c(code, s):
    return f"\033[{code}m{s}\033[0m" if TTY else s
B  = lambda s: c("1", s)
D  = lambda s: c("2", s)
G  = lambda s: c("32", s)
R  = lambda s: c("31", s)
Y  = lambda s: c("33", s)


def issues(repo):
    """Work items from the committed JSONL — no daemon, no subprocess.

    Returns None when a repo has no backlog at all, which is a different thing
    from a repo with an empty one and must not be rendered as a zero.
    """
    p = PROJECTS / repo / ".beads" / "issues.jsonl"
    if not p.exists():
        return None
    out = []
    for line in p.read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            o = json.loads(line)
        except json.JSONDecodeError:
            continue
        if o.get("deleted") or o.get("tombstone"):
            continue
        out.append(o)
    return out


def ready_ids(repo):
    """Ready work, from beads itself.

    Deliberately not reimplemented here. An early version computed readiness by
    walking `blocks` edges in the JSONL and disagreed with `br ready` on two
    issues in ai-ih-coach — beads has semantics around epics and started children
    that are not visible in the edge data alone. A panel that quietly reports
    different numbers than the tracker it is reporting on is worse than no panel;
    it is the stale-edge failure mode, with a confident-looking board on top.

    Returns None if beads cannot be reached, so the caller can say so rather than
    print a zero.
    """
    try:
        r = subprocess.run(["br", "ready", "--json"], cwd=str(PROJECTS / repo),
                           capture_output=True, text=True, timeout=30)
        if r.returncode != 0:
            return None
        d = json.loads(r.stdout)
        rows = d if isinstance(d, list) else d.get("issues", d.get("data", []))
        return {x["id"] for x in rows}
    except Exception:                                      # noqa: BLE001
        return None


def classify(rows, ready_set):
    """Split the backlog. Only `ready` involves judgement, and that comes from
    beads; everything else here is reading a status field."""
    ready, wip, waiting, done = [], [], [], []
    for o in rows:
        st = o.get("status")
        if st == "closed":
            done.append(o)
        elif st == "in_progress":
            wip.append(o)
        elif ready_set is not None and o["id"] in ready_set:
            ready.append(o)
        else:
            waiting.append(o)
    return ready, wip, waiting, done


def git(repo, *args):
    try:
        r = subprocess.run(["git", "-C", str(PROJECTS / repo), *args],
                           capture_output=True, text=True, timeout=10)
        return r.stdout.strip() if r.returncode == 0 else ""
    except Exception:                                      # noqa: BLE001
        return ""


def tree(repo):
    dirty = len([x for x in git(repo, "status", "--porcelain").splitlines() if x])
    ahead = git(repo, "rev-list", "--count", "@{u}..HEAD")
    bits = []
    if dirty:
        bits.append(Y(f"{dirty} uncommitted"))
    if ahead and ahead != "0":
        bits.append(Y(f"{ahead} unpushed"))
    return " ".join(bits) if bits else D("clean")


def gates(refresh):
    state = ROOT / "state" / "verify-latest.json"
    if refresh or not state.exists():
        subprocess.run([str(HERE / "verify-all")], capture_output=True)
    if not state.exists():
        return {}, None
    d = json.loads(state.read_text())
    by = {f["repo"]: f for f in d.get("factories", [])}
    return by, d.get("ran_at")


def age(iso):
    if not iso:
        return "never"
    try:
        t = time.mktime(time.strptime(iso, "%Y-%m-%dT%H:%M:%SZ")) - time.timezone
    except ValueError:
        return iso
    s = max(0, int(time.time() - t))
    for n, unit in ((86400, "d"), (3600, "h"), (60, "m")):
        if s >= n:
            return f"{s // n}{unit} ago"
    return f"{s}s ago"


def decisions():
    """Things waiting on Nikita.

    A hand-maintained label today. Once the runner exists this becomes the set of
    tokens parked on human nodes, and the label goes away — see
    cp-panel-graph-view-cuj. Until then the panel says which one it is showing,
    because a proxy presented as the real thing is worse than no panel.
    """
    out = []
    for f in FACTORIES:
        rows = issues(f) or []
        for o in rows:
            if o.get("status") == "closed":
                continue
            if "blocked-on-nikita" in (o.get("labels") or []):
                out.append((f, o))
    return out


def runs():
    """Edge crossings recorded so far. There is no runner yet, so: none."""
    log = STATE_DIR / "transitions.ndjson"
    if not log.exists():
        return None
    return sum(1 for l in log.read_text().splitlines() if l.strip())


def cmd_status(argv):
    refresh = "--refresh" in argv
    gate, ran = gates(refresh)

    print()
    print(D(f"  {'FACTORY':<17}{'GATE':<12}{'READY':>6}{'WIP':>5}{'WAITING':>9}   "
            f"{'TREE':<22}{'DECIDE':>7}"))
    dec = decisions()
    dec_by = {}
    for f, o in dec:
        dec_by[f] = dec_by.get(f, 0) + 1

    for f in FACTORIES:
        g = gate.get(f)
        if not g:
            mark = Y("?  unrun")
        elif g.get("ok"):
            p = len([x for x in g["checks"] if x["status"] == "pass"])
            t = len([x for x in g["checks"] if x["status"] != "skipped"])
            mark = G(f"green {p}/{t}")
        else:
            mark = R("red      ")

        rows = issues(f)
        if rows is None:
            ready = wip = blocked = D("  —")
        else:
            rs = ready_ids(f)
            r, w, b, _ = classify(rows, rs)
            ready = f"{len(r):>3}" if rs is not None else D("  ?")
            wip, blocked = f"{len(w):>3}", f"{len(b):>3}"

        n = dec_by.get(f, 0)
        dmark = Y(f"{n:>3}") if n else D("  0")
        print(f"  {f:<17}{pad(mark, 12)}{ready:>6}{wip:>5}{blocked:>9}   "
              f"{pad(tree(f), 22)}{dmark:>7}")

    print()
    nb = [f for f in FACTORIES if issues(f) is None]
    print(D(f"  gate read {age(ran)}") + D("   ·  cp status --refresh to re-run"))
    if nb:
        print(D(f"  no backlog in {', '.join(nb)} — work there is not dispatchable yet"))

    if dec:
        print()
        print(B("  WAITING ON YOU"))
        for f, o in dec:
            print(f"    {D(f):<17}{o['id']:<28}{o['title'][:44]}")

    n = runs()
    print()
    if n is None:
        print(D("  No node has ever run — the graph is documented but has no runner.")
              + D("  (cp-runner-3k1)"))
    else:
        print(D(f"  {n} edge crossings recorded"))
    print()
    return 0


def strip(s):
    """Visible width of a string that may carry ANSI colour."""
    import re
    return re.sub(r"\033\[[0-9;]*m", "", s)


def pad(s, width):
    """Left-align to a visible width. str.ljust counts escape bytes, so it
    silently misaligns every coloured column."""
    return s + " " * max(0, width - len(strip(s)))


def cmd_work(argv):
    if not argv:
        print("cp work <factory>", file=sys.stderr)
        return 2
    f = argv[0]
    rows = issues(f)
    if rows is None:
        print(f"  {f} has no backlog. Its work is not dispatchable yet.")
        return 0
    ready, wip, waiting, done = classify(rows, ready_ids(f))
    print()
    for label, group, col in (("IN PROGRESS", wip, Y), ("READY", ready, G),
                              ("WAITING", waiting, D)):
        if not group:
            continue
        print(f"  {B(label)}  {D(str(len(group)))}")
        for o in sorted(group, key=lambda x: (x.get("priority", 9), x["id"]))[:20]:
            print(f"    {D('P' + str(o.get('priority', '?')))} {o['id']:<30}{o['title'][:52]}")
        if len(group) > 20:
            print(D(f"    … {len(group) - 20} more"))
        print()
    print(D(f"  {len(done)} closed"))
    print()
    return 0


def cmd_decisions(argv):
    dec = decisions()
    print()
    if not dec:
        print("  Nothing is waiting on you.")
    else:
        for f, o in dec:
            print(f"  {B(o['id'])}  {D(f)}")
            print(f"    {o['title']}")
            print()
    print(D("  Today this is the `blocked-on-nikita` label, not parked tokens —"))
    print(D("  the graph has no runner yet (cp-panel-graph-view-cuj)."))
    print()
    return 0


def api_state():
    """Everything the panel needs, in one read. Small enough that polling it is
    cheaper than keeping a socket open and reasoning about staleness."""
    gate, ran = gates(False)
    out = {"ran_at": ran, "factories": [], "graph": {}, "node_types": {},
           "tokens": [], "transitions": [], "generated": time.strftime("%H:%M:%S"),
           "scenarios": sorted(p.stem[4:] for p in
                               (ROOT / "tests" / "fixtures").glob("run-*.json")),
           "live": False}
    try:
        out["graph"] = json.loads((ROOT / "nodes" / "graph.json").read_text())
        out["node_types"] = json.loads((ROOT / "nodes" / "node-types.json").read_text())
    except Exception:                                      # noqa: BLE001
        pass

    for f in FACTORIES:
        rows = issues(f)
        entry = {"name": f, "gate": gate.get(f), "tree": strip(tree(f)),
                 "backlog": rows is not None}
        if rows is not None:
            rs = ready_ids(f)
            r, w, wait, done = classify(rows, rs)
            entry["work"] = {"ready": len(r), "wip": len(w),
                             "waiting": len(wait), "done": len(done),
                             "ready_known": rs is not None}
            entry["issues"] = [
                {"id": o["id"], "title": o.get("title", ""), "status": o.get("status"),
                 "priority": o.get("priority"), "type": o.get("issue_type"),
                 "bucket": ("wip" if o in w else "ready" if o in r
                            else "waiting" if o in wait else "done")}
                for o in rows if o.get("status") != "closed"]
        out["factories"].append(entry)

    titles = {}
    for f in FACTORIES:
        for o in (issues(f) or []):
            titles[(f, o["id"])] = {"title": o.get("title", ""),
                                    "status": o.get("status"),
                                    "priority": o.get("priority"),
                                    "type": o.get("issue_type")}

    tdir = STATE_DIR / "tokens"
    if tdir.exists():
        for p in sorted(tdir.glob("*.json")):
            try:
                t = json.loads(p.read_text())
                t["waiting_since"] = t.get("updated")
                # None when the token is not a tracked issue — a demo run, say.
                # The panel says so rather than showing a blank where work goes.
                t["issue"] = titles.get((t.get("factory"), t.get("token")))
                out["tokens"].append(t)
            except Exception:                              # noqa: BLE001
                pass
    log = STATE_DIR / "transitions.ndjson"
    if log.exists():
        for line in log.read_text().splitlines():
            if line.strip():
                try:
                    out["transitions"].append(json.loads(line))
                except Exception:                          # noqa: BLE001
                    pass
    out["decisions"] = [{"factory": f, "id": o["id"], "title": o["title"]}
                        for f, o in decisions()]
    return out


def cmd_serve(argv):
    import http.server
    import socketserver

    port = 7777
    if "--port" in argv:
        port = int(argv[argv.index("--port") + 1])
    page = ROOT / "web" / "index.html"
    if not page.exists():
        print(f"cp: no page at {page}", file=sys.stderr)
        return 2

    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass                                            # the board is the output

        def do_POST(self):
            """Answer a parked token.

            The panel is read-only about work — advancing a token is the runner's
            job and this does not do it. What it does is carry a person's answer
            to a human node, which is the one input the graph cannot produce for
            itself.

            The answer is checked against that token's own declared options
            before it goes anywhere, so the endpoint can only ever choose one of
            the branches the parking node offered. It cannot name an arbitrary
            edge, which would be a way to walk a token anywhere from a browser.
            """
            if self.path == "/api/dispatch":
                return self.dispatch()
            if self.path != "/api/answer":
                return self.reply(404, {"error": f"no POST endpoint at {self.path}"})
            try:
                n = int(self.headers.get("Content-Length", 0))
                if n > 4096:
                    raise ValueError("body too large")
                body = json.loads(self.rfile.read(n) or b"{}")
                tid, value = body.get("token"), body.get("value")
            except Exception as e:                          # noqa: BLE001
                return self.reply(400, {"error": f"bad request: {e}"})

            tp = STATE_DIR / "tokens" / f"{tid}.json"
            if not tid or "/" in str(tid) or ".." in str(tid) or not tp.exists():
                return self.reply(404, {"error": "no such token"})
            tok = json.loads(tp.read_text())
            if tok.get("status") != "parked":
                return self.reply(409, {"error": f"{tid} is {tok.get('status')}, not parked"})
            opts = [o["value"] for o in (tok.get("question") or {}).get("options", [])]
            if value not in opts:
                return self.reply(400, {"error": f"{value!r} is not one of {opts}"})

            r = subprocess.run([str(HERE / "cp-run"), "--resume", tid,
                                "--answer", value, "--via", "web"],
                               capture_output=True, text=True, timeout=600, cwd=str(ROOT))
            if r.returncode != 0:
                return self.reply(500, {"error": r.stderr.strip() or "runner failed"})
            after = json.loads(tp.read_text())
            return self.reply(200, {"ok": True, "token": tid,
                                    "status": after.get("status"), "node": after.get("node")})

        def dispatch(self):
            """Put a backlog issue into the graph as a token.

            Constrained on purpose. The token id must be an issue that is
            actually ready in that factory — not any string a browser can send —
            so the panel can only dispatch work the tracker already agreed is
            startable. Anything looser and this becomes a way to create arbitrary
            state files from a web page.
            """
            try:
                n = int(self.headers.get("Content-Length", 0))
                if n > 4096:
                    raise ValueError("body too large")
                b = json.loads(self.rfile.read(n) or b"{}")
                factory, tid, scen = b.get("factory"), b.get("token"), b.get("scenario", "happy")
            except Exception as e:                          # noqa: BLE001
                return self.reply(400, {"error": f"bad request: {e}"})

            graph = json.loads((ROOT / "nodes" / "graph.json").read_text())
            if factory not in graph["factories"]:
                return self.reply(400, {"error": f"{factory!r} is not a factory"})

            rs = ready_ids(factory)
            if rs is None:
                return self.reply(409, {"error": f"cannot read {factory}'s backlog"})
            if tid not in rs:
                return self.reply(400, {"error": f"{tid!r} is not ready work in {factory}. "
                                                 "The panel dispatches what the tracker says "
                                                 "is startable, nothing else."})

            # beads lists epics in `br ready`, but an epic is a container. You
            # start its children; a token for one would sit in the graph
            # representing work that no single node can do.
            kind = next((o.get("issue_type") for o in (issues(factory) or [])
                         if o["id"] == tid), None)
            if kind == "epic":
                return self.reply(400, {"error": f"{tid} is an epic. Dispatch one of its "
                                                 "children — an epic is a container, not work."})

            if not SCENARIO.match(str(scen)):
                return self.reply(400, {"error": "bad scenario name"})
            if not (ROOT / "tests" / "fixtures" / f"run-{scen}.json").exists():
                return self.reply(400, {"error": f"no scenario {scen!r}"})

            tp = STATE_DIR / "tokens" / f"{tid}.json"
            if tp.exists():
                prev = json.loads(tp.read_text())
                if prev.get("status") != "done":
                    return self.reply(409, {"error": f"{tid} is already {prev.get('status')} "
                                                     f"at {prev.get('node')}"})

            r = subprocess.run([str(HERE / "cp-run"), factory, tid,
                                "--dry-run", "--scenario", scen],
                               capture_output=True, text=True, timeout=600, cwd=str(ROOT))
            if r.returncode != 0:
                return self.reply(500, {"error": r.stderr.strip() or "runner failed"})
            t = json.loads(tp.read_text())
            return self.reply(200, {"ok": True, "token": tid,
                                    "status": t["status"], "node": t["node"]})

        def reply(self, code, obj):
            body = json.dumps(obj).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            if self.path.startswith("/api/state"):
                body = json.dumps(api_state()).encode()
                ctype = "application/json"
            elif self.path in ("/", "/index.html"):
                body = page.read_bytes()
                ctype = "text/html; charset=utf-8"
            else:
                self.send_error(404)
                return
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.TCPServer(("127.0.0.1", port), H) as srv:
        print(f"\n  {B('cp serve')}  http://127.0.0.1:{port}")
        print(D("  bound to loopback only — the panel lives where the work lives\n"))
        try:
            srv.serve_forever()
        except KeyboardInterrupt:
            print(D("  stopped\n"))
    return 0


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]
    fn = {"status": cmd_status, "work": cmd_work, "decisions": cmd_decisions,
          "serve": cmd_serve}.get(cmd)
    if not fn:
        print(f"cp: unknown command {cmd!r}. Try --help.", file=sys.stderr)
        return 2
    return fn(rest)


if __name__ == "__main__":
    sys.exit(main())
